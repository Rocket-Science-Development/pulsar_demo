# Database Configuration
# InfluxDB credentials used across all services
DB_USER=admin
DB_PASSWORD=pass123
DB_HOST=influxdb
DB_PORT=8086

# Grafana Configuration
# Admin credentials for Grafana dashboard access
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=pass123

# InfluxDB Configuration (used by InfluxDB container)
# These should match DB_USER and DB_PASSWORD for consistency
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=pass123
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=pass123
INFLUXDB_HTTP_AUTH_ENABLED=false

# Chronograf Configuration
# URL and credentials for InfluxDB connection
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=pass123