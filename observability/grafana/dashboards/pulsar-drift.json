    {
      "type": "table",
      "title": "Latest window: tests by feature",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r.metric_type == \"drift\") |> filter(fn: (r) => r._field == \"metric_value\" or r._field == \"p_adjusted\" or r._field == \"status\" or r._field == \"confirmed\") |> last() |> toFloat() |> group() |> pivot(rowKey: [\"feature_name\", \"metric_name\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> keep(columns: [\"feature_name\", \"metric_name\", \"metric_value\", \"p_adjusted\", \"status\", \"confirmed\"])"
