      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"model_id\", predicate: (r) => r._measurement == \"pulsar_results\", start: -30d) |> filter(fn: (r) => r._value != \"permit_assistant\")",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "admissibilite",
