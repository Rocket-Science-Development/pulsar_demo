        },
        {
          "refId": "D",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"permit_assistant_1.0_input_data\") |> filter(fn: (r) => r.record_type == \"agent_run\") |> filter(fn: (r) => r._field == \"pii_leak_count\") |> group() |> aggregateWindow(every: 1m, fn: sum, createEmpty: false) |> set(key: \"role\", value: \"leak\") |> group(columns: [\"role\"]) |> drop(fn: (column) => column == \"_start\" or column == \"_stop\")"
