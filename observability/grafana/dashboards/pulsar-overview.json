          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r.metric_type == \"drift\" and r._field == \"confirmed\") |> last() |> toInt() |> group() |> sum()"
        }
