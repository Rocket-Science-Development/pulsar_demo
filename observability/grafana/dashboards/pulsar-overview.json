    {
      "type": "table",
      "title": "Latest verdict by kind",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r._field == \"status\") |> filter(fn: (r) => r.metric_type != \"statistics\") |> last() |> group(columns: [\"metric_type\"]) |> reduce(identity: {established: 0, within: 0, inconclusive: 0}, fn: (r, accumulator) => ({established: accumulator.established + (if r._value == 1 then 1 else 0), within: accumulator.within + (if r._value == 0 then 1 else 0), inconclusive: accumulator.inconclusive + (if r._value == -1 then 1 else 0)})) |> group()"
        }
      ],
