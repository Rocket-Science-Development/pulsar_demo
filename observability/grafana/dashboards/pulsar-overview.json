{
  "uid": "pulsar-overview",
  "title": "Pulsar.ml — Overview",
  "description": "State of every monitored model: captures, confirmed drift, fairness, personal information, capture health",
  "tags": [
    "pulsar.ml"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "monitoring",
        "current": {
          "text": "monitoring",
          "value": "monitoring"
        },
        "hide": 0
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"model_id\", predicate: (r) => r._measurement == \"pulsar_results\" and r.model_id != \"permit_assistant\", start: -30d)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "admissibilite",
          "value": "admissibilite"
        }
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"model_version\", predicate: (r) => r._measurement == \"pulsar_results\" and r.model_id == \"${model}\", start: -30d)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "1.0",
          "value": "1.0"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Pulsar.ml — monitoring overview\nEvery tile shows the **latest verdict**, never a raw score: a drift counts only once confirmed over two windows, a disparity only when its confidence interval leaves the acceptable zone. Click a tile to open the detailed dashboard."
      },
      "datasource": null,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Predictions captured (period)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"${model}_${version}_input_data\") |> filter(fn: (r) => r._field == \"y_pred\") |> group() |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "Open performance",
              "url": "/d/pulsar-performance?${__url_time_range}&${__all_variables}"
