    {
      "type": "timeseries",
      "title": "Alerts over time, by kind",
      "description": "Number of results establishing a change in each 6-hour window",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r._field == \"status\") |> filter(fn: (r) => r._value == 1 and (r.metric_type == \"drift\" or r.metric_type == \"fairness\" or r.metric_type == \"explainability\" or r.metric_type == \"performance\")) |> group(columns: [\"metric_type\"]) |> aggregateWindow(every: 6h, fn: count, createEmpty: false) |> drop(fn: (column) => column == \"_start\" or column == \"_stop\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": null,
          "max": null,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 70,
            "pointSize": 6,
            "showPoints": "auto",
            "drawStyle": "bars",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": null,
            "barAlignment": 0,
            "thresholdsStyle": {
              "mode": "off"
            },
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
