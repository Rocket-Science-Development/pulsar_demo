{
  "uid": "pulsar-explain",
  "title": "Pulsar.ml — Explanations",
  "description": "What the model relies on (TreeSHAP), ranking stability, changes of weight and importance by group",
  "tags": [
    "pulsar.ml"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "monitoring",
        "current": {
          "text": "monitoring",
          "value": "monitoring"
        },
        "hide": 0
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"model_id\", predicate: (r) => r._measurement == \"pulsar_results\", start: -30d) |> filter(fn: (r) => r._value != \"permit_assistant\")",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "admissibilite",
          "value": "admissibilite"
        }
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"model_version\", predicate: (r) => r._measurement == \"pulsar_results\" and r.model_id == \"${model}\", start: -30d)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "1.0",
          "value": "1.0"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Explanations are estimates too: every change carries a bootstrap interval, and no verdict is given when the ranking is not stable on the reference window. A rule applied **after** the model (such as a bias added in production) does not show here: explanations describe the model, not the decision pipeline."
      },
      "datasource": null,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "timeseries",
      "title": "Share of the total importance, by feature",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r.metric_type == \"explainability\") |> filter(fn: (r) => r.metric_name == \"importance_share\" and r._field == \"metric_value\") |> group(columns: [\"feature_name\"]) |> drop(fn: (column) => column == \"_start\" or column == \"_stop\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 80,
            "pointSize": 6,
            "showPoints": "auto",
            "drawStyle": "line",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": null,
            "barAlignment": 0,
            "thresholdsStyle": {
              "mode": "off"
            },
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "displayName": "${__field.labels.feature_name}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "pulsar-influx"
      }
    },
    {
      "type": "timeseries",
      "title": "Ranking stability (top 3): NDCG and overlap",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r.metric_type == \"explainability\") |> filter(fn: (r) => r.metric_name == \"attribution_ndcg_at_k\" and r._field == \"metric_value\") |> set(key: \"s\", value: \"NDCG@3 (threshold 0.9)\") |> group(columns: [\"s\"]) |> drop(fn: (column) => column == \"_start\" or column == \"_stop\")"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r.metric_type == \"explainability\") |> filter(fn: (r) => r.metric_name == \"attribution_top_k_jaccard\" and r._field == \"metric_value\") |> set(key: \"s\", value: \"top-3 overlap (threshold 0.6)\") |> group(columns: [\"s\"]) |> drop(fn: (column) => column == \"_start\" or column == \"_stop\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1.05,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 6,
            "showPoints": "auto",
            "drawStyle": "line",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": null,
            "barAlignment": 0,
            "thresholdsStyle": {
              "mode": "area"
