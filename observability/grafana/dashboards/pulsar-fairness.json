  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**How to read**: a disparity is **established** only when its confidence interval lies entirely outside the acceptable zone (disparate impact ratio 0.8 to 1.25, the 4/5 rule; parity difference ±0.10). Small groups (< 30) are never shown. The anytime-valid monitor keeps its false-alarm rate below 5 % however often it is looked at."
      },
      "datasource": null,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "table",
      "title": "Latest window, by group",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "pulsar-influx"
          },
          "query": "from(bucket: \"${bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"pulsar_results\") |> filter(fn: (r) => r.model_id == \"${model}\" and r.metric_type == \"fairness\" and r.test_type == \"fixed\" and r.feature_name == \"${attribute}\") |> filter(fn: (r) => r._field == \"metric_value\" or r._field == \"ci_low\" or r._field == \"ci_high\" or r._field == \"n\" or r._field == \"status\") |> last() |> toFloat() |> group() |> pivot(rowKey: [\"group\", \"metric_name\", \"reference_group\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> keep(columns: [\"group\", \"reference_group\", \"metric_name\", \"n\", \"metric_value\", \"ci_low\", \"ci_high\", \"status\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "group": 0,
              "reference_group": 1,
              "metric_name": 2,
              "n": 3,
              "metric_value": 4,
              "ci_low": 5,
              "ci_high": 6,
              "status": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
