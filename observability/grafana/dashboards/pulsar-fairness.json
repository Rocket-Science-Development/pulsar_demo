{
  "uid": "pulsar-fairness",
  "title": "Pulsar.ml — Fairness",
  "description": "Disparities between groups with confidence intervals, anytime-valid monitoring and counterfactual probes",
  "tags": [
    "pulsar.ml"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "monitoring",
        "current": {
          "text": "monitoring",
          "value": "monitoring"
        },
        "hide": 0
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"model_id\", predicate: (r) => r._measurement == \"pulsar_results\" and r.model_id != \"permit_assistant\", start: -30d)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "admissibilite",
          "value": "admissibilite"
        }
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"model_version\", predicate: (r) => r._measurement == \"pulsar_results\" and r.model_id == \"${model}\", start: -30d)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "1.0",
          "value": "1.0"
        }
      },
      {
        "name": "attribute",
        "label": "Attribute",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"feature_name\", predicate: (r) => r._measurement == \"pulsar_results\" and r.model_id == \"${model}\" and r.metric_type == \"fairness\" and r.test_type == \"fixed\", start: -30d)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "language",
          "value": "language"
        }
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "pulsar-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"group\", predicate: (r) => r._measurement == \"pulsar_results\" and r.model_id == \"${model}\" and r.feature_name == \"${attribute}\", start: -30d)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "text": "language=other",
          "value": "language=other"
        }
